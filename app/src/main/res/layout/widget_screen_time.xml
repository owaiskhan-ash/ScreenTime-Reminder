<?xml version="1.0" encoding="utf-8"?>
<!-- Small 2x1 home-screen widget: just the eye and today's time.
     No background, no outline — the wallpaper is the only surface. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/widget_eye"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_widget_eye"
        android:contentDescription="@string/widget_eye_cd" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="0h 0m"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:shadowColor="#66000000"
        android:shadowRadius="2"
        android:shadowDy="1" />
</LinearLayout>
